#!/bin/bash
# =============================================================================
# Pre-commit hook for Bedrock Protected Mode
# =============================================================================
# This hook prevents committing sensitive data and validates security practices
#
# To install: git config core.hooksPath .githooks
# =============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "Running pre-commit security checks..."
echo ""

ERRORS=0

# =============================================================================
# Check 1: No AWS credentials or keys
# =============================================================================
echo -n "Checking for AWS credentials... "

# Check for AWS Access Key patterns (exclude this script itself)
STAGED_FILES=$(git diff --cached --name-only | grep -v 'pre-commit$' || true)
CRED_FOUND=0

if [ -n "$STAGED_FILES" ]; then
    # Check for AKIA (Access Key ID) - 20 char alphanumeric starting with AKIA
    if echo "$STAGED_FILES" | xargs grep -lE 'AK[I][A][0-9A-Z]{16}' 2>/dev/null; then
        CRED_FOUND=1
    fi
    # Check for aws_secret_access_key assignments
    if echo "$STAGED_FILES" | xargs grep -lE 'aws_secret_access_key\s*=' 2>/dev/null; then
        CRED_FOUND=1
    fi
    # Check for ASIA (Temporary credentials)
    if echo "$STAGED_FILES" | xargs grep -lE 'AS[I][A][0-9A-Z]{16}' 2>/dev/null; then
        CRED_FOUND=1
    fi
fi

if [ $CRED_FOUND -eq 1 ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}ERROR: Potential AWS credentials detected!${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# =============================================================================
# Check 2: No .tfvars files (except examples)
# =============================================================================
echo -n "Checking for .tfvars files... "

TFVARS_FILES=$(git diff --cached --name-only | grep '\.tfvars$' | grep -v '\.tfvars\.example$' || true)
if [ -n "$TFVARS_FILES" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}ERROR: .tfvars files should not be committed (may contain secrets)${NC}"
    echo "Files: $TFVARS_FILES"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# =============================================================================
# Check 3: No prompt files
# =============================================================================
echo -n "Checking for prompt files... "

PROMPT_FILES=$(git diff --cached --name-only | grep -E '(system\.txt|instruction\.txt|\.prompt)$' | grep -v '\.example$' || true)
if [ -n "$PROMPT_FILES" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}ERROR: Prompt files contain IP and should not be committed${NC}"
    echo "Files: $PROMPT_FILES"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# =============================================================================
# Check 4: No .env files (except examples)
# =============================================================================
echo -n "Checking for .env files... "

ENV_FILES=$(git diff --cached --name-only | grep -E '\.env$|\.env\.' | grep -v '\.example$' || true)
if [ -n "$ENV_FILES" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}ERROR: .env files may contain secrets${NC}"
    echo "Files: $ENV_FILES"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# =============================================================================
# Check 5: No private keys
# =============================================================================
echo -n "Checking for private keys... "

KEY_FILES=$(git diff --cached --name-only | grep -E '\.(pem|key|p12|pfx)$|_rsa$|_dsa$|_ecdsa$|_ed25519$' || true)
if [ -n "$KEY_FILES" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}ERROR: Private key files should never be committed${NC}"
    echo "Files: $KEY_FILES"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# =============================================================================
# Check 6: No secrets.auto.tfvars
# =============================================================================
echo -n "Checking for secrets.auto.tfvars... "

SECRETS_FILES=$(git diff --cached --name-only | grep 'secrets\.auto\.tfvars$' || true)
if [ -n "$SECRETS_FILES" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}ERROR: secrets.auto.tfvars contains sensitive prompts${NC}"
    echo "Files: $SECRETS_FILES"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# =============================================================================
# Check 7: No terraform state files
# =============================================================================
echo -n "Checking for terraform state files... "

STATE_FILES=$(git diff --cached --name-only | grep -E '\.tfstate$|\.tfstate\.' || true)
if [ -n "$STATE_FILES" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}ERROR: Terraform state files contain sensitive data${NC}"
    echo "Files: $STATE_FILES"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# =============================================================================
# Check 8: No .lh directory (Local History)
# =============================================================================
echo -n "Checking for .lh directory... "

LH_FILES=$(git diff --cached --name-only | grep '^\.lh/' || true)
if [ -n "$LH_FILES" ]; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${RED}ERROR: .lh directory should not be committed${NC}"
    echo "Files: $LH_FILES"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}OK${NC}"
fi

# =============================================================================
# Check 9: No hardcoded account IDs in unexpected places
# =============================================================================
echo -n "Checking for hardcoded account IDs... "

# Check for account IDs outside of expected files
ACCOUNT_ID_FILES=$(git diff --cached --name-only | xargs grep -l '[0-9]\{12\}' 2>/dev/null | grep -v -E '(\.md$|\.example$|CLAUDE\.md$|variables\.tf$|outputs\.tf$)' || true)
if [ -n "$ACCOUNT_ID_FILES" ]; then
    echo -e "${YELLOW}WARNING${NC}"
    echo -e "${YELLOW}WARNING: Potential hardcoded account IDs found in:${NC}"
    echo "$ACCOUNT_ID_FILES"
    echo "Please verify these are intentional."
else
    echo -e "${GREEN}OK${NC}"
fi

# =============================================================================
# Check 10: Validate Terraform syntax (if terraform is installed)
# =============================================================================
if command -v terraform &> /dev/null; then
    echo -n "Validating Terraform syntax... "

    TF_DIRS=$(git diff --cached --name-only | grep '\.tf$' | xargs -I {} dirname {} | sort -u || true)
    TF_ERRORS=0

    for dir in $TF_DIRS; do
        if [ -d "$dir" ]; then
            if ! terraform -chdir="$dir" validate -no-color &> /dev/null; then
                TF_ERRORS=$((TF_ERRORS + 1))
                echo -e "${YELLOW}WARNING: Terraform validation failed in $dir${NC}"
            fi
        fi
    done

    if [ $TF_ERRORS -eq 0 ]; then
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${YELLOW}Skipping Terraform validation (terraform not installed)${NC}"
fi

# =============================================================================
# Final Result
# =============================================================================
echo ""
if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}=============================================================================${NC}"
    echo -e "${RED}PRE-COMMIT FAILED: $ERRORS error(s) found${NC}"
    echo -e "${RED}=============================================================================${NC}"
    echo ""
    echo "To bypass this check (NOT RECOMMENDED), use: git commit --no-verify"
    echo ""
    exit 1
else
    echo -e "${GREEN}=============================================================================${NC}"
    echo -e "${GREEN}PRE-COMMIT PASSED: All security checks passed${NC}"
    echo -e "${GREEN}=============================================================================${NC}"
    exit 0
fi
