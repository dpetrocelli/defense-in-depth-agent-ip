# Central Account Configuration
# Copy this file to terraform.tfvars and fill in your values

region       = "us-east-1"
project_name = "bedrock-protected"

# List of client account IDs that can use this agent
client_account_ids = [
  "111111111446",  # Client 1
  "222222222179",  # Client 2
]

# AWS Profile (optional - can also use AWS_PROFILE env var)
# aws_profile = "your-central-account-profile"

# Optional: Email for security alerts
alert_email = "security@yourcompany.com"

# Optional: Slack webhook for security alerts
# slack_webhook_url = "https://hooks.slack.com/services/xxx/yyy/zzz"

# =============================================================================
# Budget Alerting (optional - alerts sent to alert_email and SNS topic)
# =============================================================================

# Monthly budget for entire project (default: $100)
# monthly_budget_limit = "100"

# Monthly budget for Bedrock usage specifically (default: $50)
# bedrock_budget_limit = "50"

# Monthly budget for Lambda usage (default: $20)
# lambda_budget_limit = "20"
