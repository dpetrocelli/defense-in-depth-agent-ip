# Central Account Configuration
# Copy this file to terraform.tfvars and fill in your values

region            = "us-east-1"
project_name      = "bedrock-protected"
client_account_id = "REPLACE_WITH_CLIENT_ACCOUNT_ID"

# AWS Profile (optional - can also use AWS_PROFILE env var)
# aws_profile = "your-central-account-profile"

# Optional: Email for security alerts
alert_email = "security@yourcompany.com"

# Optional: Slack webhook for security alerts
# slack_webhook_url = "https://hooks.slack.com/services/xxx/yyy/zzz"
