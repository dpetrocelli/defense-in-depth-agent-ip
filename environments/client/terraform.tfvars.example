# Client Account Configuration
# Copy this file to terraform.tfvars and fill in your values
#
# After deploying the central account, run:
#   cd ../central && terraform output for_client_environment
# to get the values below

region             = "us-east-1"
project_name       = "bedrock-protected"
client_name        = "your-client-name"
central_account_id = "REPLACE_WITH_CENTRAL_ACCOUNT_ID"

# AWS Profile (optional - can also use AWS_PROFILE env var)
# aws_profile = "your-client-account-profile"

# =============================================================================
# From Central Account Outputs (terraform output for_client_environment)
# =============================================================================

# ECR repository URL for the agent container
ecr_repository_url = "REPLACE_WITH_ECR_URL"

# Container image tag
container_image_tag = "v1"

# ARN of the Secrets Manager secret containing agent prompts
agent_prompts_secret_arn = "REPLACE_WITH_SECRET_ARN"

# ARN of the KMS key used to encrypt the secrets
secrets_kms_key_arn = "REPLACE_WITH_KMS_KEY_ARN"

# SNS topic for security alerts
central_sns_topic_arn = "REPLACE_WITH_SNS_TOPIC_ARN"

# S3 bucket for audit logs
central_audit_bucket_arn  = "REPLACE_WITH_S3_BUCKET_ARN"
central_audit_bucket_name = "REPLACE_WITH_S3_BUCKET_NAME"

# =============================================================================
# Optional ECS Configuration
# =============================================================================

# foundation_model  = "amazon.nova-lite-v1:0"
# ecs_cpu           = 512
# ecs_memory        = 1024
# ecs_desired_count = 1
