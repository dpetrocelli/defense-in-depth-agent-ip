# =============================================================================
# LOCAL DEVELOPMENT DOCKERFILE
# =============================================================================
# Stripped-down version of Dockerfile for local use:
#   - Uses python:3.12-slim instead of the Lambda base image
#   - Does NOT require BuildKit signing key secret
#   - Runs with uvicorn (not Lambda handler)
#   - Security layers (L2/L3/L4) remain fully active
#
# Build: docker compose -f local/docker-compose.yml build
# =============================================================================

FROM python:3.12-slim

WORKDIR /var/task

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "openai>=1.0.0" "litellm>=1.0.0" "ollama>=0.4.0"

# Copy application code
COPY app/ ./app/

# Expose FastAPI port
EXPOSE 8080

# Run with uvicorn (not Lambda handler)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "info"]
